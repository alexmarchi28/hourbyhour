<?xml version="1.0" encoding="utf-8"?>
<!--
    Places an event by fractions of its day column. A LinearLayout with weightSum S and a single
    child of weight 1 gives that child 1/S of the space; gravity decides on which side. WidgetViews
    sets the four weightSums: event_v1 and event_v2 place it vertically (start and end time),
    event_h1 and event_h2 horizontally (its column among overlapping events). The box itself
    (event_box.xml or event_box_compact.xml) is added into event_h2.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_v1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/column_separator"
    android:gravity="bottom"
    android:orientation="vertical"
    tools:ignore="NestedWeights,UselessParent">

    <LinearLayout
        android:id="@+id/event_v2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/event_h1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="end"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/event_h2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
