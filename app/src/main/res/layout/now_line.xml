<?xml version="1.0" encoding="utf-8"?>
<!-- The current time: now_position covers the column from the current time down, the line sits on its top edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/now_position"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="bottom"
    android:orientation="vertical"
    tools:ignore="UselessParent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="-1dp"
            android:background="@color/widget_now" />

        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="-4dp"
            android:background="@drawable/now_dot" />
    </FrameLayout>
</LinearLayout>
