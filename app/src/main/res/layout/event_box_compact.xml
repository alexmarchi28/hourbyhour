<?xml version="1.0" encoding="utf-8"?>
<!--
    A short event: one line of text that autosize shrinks to the real height of the box, which the
    widget does not know in advance. Also used without text for events too short for any title.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/event_box"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/event_margin"
    android:layout_marginBottom="@dimen/event_margin_bottom"
    android:layout_weight="1"
    android:autoSizeMaxTextSize="@dimen/event_text_size"
    android:autoSizeMinTextSize="@dimen/event_text_min_size"
    android:autoSizeStepGranularity="1sp"
    android:autoSizeTextType="uniform"
    android:background="@drawable/event_background"
    android:ellipsize="end"
    android:fontFamily="sans-serif-medium"
    android:gravity="center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:paddingHorizontal="@dimen/event_padding_horizontal" />
