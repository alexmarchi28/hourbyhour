<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1A73E8</color>

    <!--
        Widget, light theme. The night variants are in values-night. The colors are references to the
        system palette (Material You): the launcher resolves them when it inflates the widget, so they
        follow the colors of the phone. The background is opaque here: WidgetViews applies the
        transparency chosen for each widget. The current time stays red, as in Google Calendar.
    -->
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_grid">@android:color/system_neutral2_100</color>
    <color name="widget_today">@android:color/system_accent1_600</color>
    <color name="widget_now">#D93025</color>

    <!--
        Screens of the app (themes.xml), light theme: the system palette, like the widget. The text
        colors used by the theme are the selectors in res/color, which fade them when disabled.
    -->
    <color name="app_background">@android:color/system_neutral1_10</color>
    <color name="app_text">@android:color/system_neutral1_900</color>
    <color name="app_text_muted">@android:color/system_neutral2_700</color>
    <color name="app_accent">@android:color/system_accent1_600</color>
    <color name="app_button">@android:color/system_accent1_100</color>

    <!--
        Events of the widget picker preview (widget_preview.xml): the colors that eventColors() gives
        to SampleAgenda.PEACOCK, FLAMINGO and GRAPE in this theme. WidgetPickerPreviewDeviceTest checks them.
    -->
    <color name="preview_peacock">#66AEE9</color>
    <color name="preview_flamingo">#ED978E</color>
    <color name="preview_grape">#A559B8</color>
    <color name="preview_event_text">#FFFFFF</color>
</resources>
